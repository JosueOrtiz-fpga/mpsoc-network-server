# tests/hil/scripts/hil.env - HIL bench settings, sourced by the scripts in tests/hil/scripts/.
#
# Point-to-point link: host's spare NIC <-> ZUBoard Ethernet (GEM2).
# Static addresses on both ends, so no DHCP server is needed.
# Every value can be overridden from the environment (HIL_HOST_IP=... make hil-stage).

: "${HIL_HOST_IP:=192.168.77.1}"
: "${HIL_BOARD_IP:=192.168.77.2}"
: "${HIL_NETMASK:=255.255.255.0}"

# Root of everything the board fetches. Served read-only over TFTP (tftp-root)
# and exported over NFS to HIL_BOARD_IP. One subdirectory per staged build.
: "${HIL_SRV:=/srv/hil}"

# make release: one directory per tag, never overwritten (the only copy of each release:
# keep it in the host's backups). Created by setup-host.sh.
: "${HIL_RELEASES:=/srv/releases}"

# Locally administered MAC, used by U-Boot only if it has no ethaddr yet.
# Replace once the MAC EEPROM is wired up (sw/meta-zub1cg/README.md).
: "${HIL_BOARD_MAC:=02:00:5a:b1:1c:01}"

# J16 UART (FT2232H interface 1). The by-id name survives other USB serial adapters,
# which shift the ttyUSB numbering. List candidates with: ls -l /dev/serial/by-id/
: "${HIL_CONSOLE:=/dev/serial/by-id/usb-Xilinx_JTAG+Serial_1234-oj1-if01-port0}"

# Test login that stage-netboot.sh seeds into every staged rootfs (never into the
# image). setup-host.sh creates the key pair; only the public key leaves this host.
: "${HIL_SSH_USER:=amd-edf}"
: "${HIL_SSH_KEY:=$HOME/.ssh/zub1cg_hil}"

# dfx-mgr package name for the staged PL package: /lib/firmware/xilinx/<name>/, and the
# default firmware that dfx-mgr-fw-load.service loads at boot.
: "${HIL_PL_PKG:=zub1cg}"

# make hil: time limits in seconds per boot step (typical values from the bench log).
: "${HIL_T_JTAG:=120}"     # xsdb jtag-boot.tcl: PMUFW, FSBL (5 s wait), U-Boot, TF-A
: "${HIL_T_UBOOT:=60}"     # xsdb done -> ZynqMP> prompt (a few s)
: "${HIL_T_KERNEL:=60}"    # netboot script -> "Starting kernel" (TFTP of 32 MB: ~3 s)
: "${HIL_T_LOGIN:=240}"    # "Starting kernel" -> login prompt (~20 s on the NFS root)
: "${HIL_T_SSH:=90}"       # login prompt -> SSH login works
