# tests/hil/scripts/hil.env - HIL bench settings, sourced by tests/hil/scripts/stage-netboot.sh.
#
# Point-to-point link: host's spare NIC <-> ZUBoard Ethernet (GEM2).
# Static addresses on both ends, so no DHCP server is needed.
# Every value can be overridden from the environment (HIL_HOST_IP=... make hil-stage).

: "${HIL_HOST_IP:=192.168.77.1}"
: "${HIL_BOARD_IP:=192.168.77.2}"
: "${HIL_NETMASK:=255.255.255.0}"

# Root of everything the board fetches. Served read-only over TFTP (tftp-root)
# and exported over NFS to HIL_BOARD_IP. One subdirectory per staged build.
: "${HIL_SRV:=/srv/hil}"

# Locally administered MAC, used by U-Boot only if it has no ethaddr yet.
# Replace once the MAC EEPROM is wired up (sw/meta-zub1cg/README.md).
: "${HIL_BOARD_MAC:=02:00:5a:b1:1c:01}"
