# Single source of truth for tool, layer and board versions.
#
# Plain KEY=value lines only: this file is read by both make and sh.
# Keep comments on their own lines, because make keeps the whitespace
# before an inline comment as part of the value.

# --- Hardware ----------------------------------------------------------

# AMD Vivado release. hw/bd/*.tcl was generated with this version and
# refuses to run in any other one.
VIVADO_VERSION=2026.1

# Target device and Avnet/Tria board definition (used by the board flow).
PART=xczu1cg-sbva484-1-e
BOARD_PART=avnet-tria:zuboard_1cg:part0:1.2

# Verilator for hw-lint and the cocotb testbenches. Built from this release tag by
# tests/hil/scripts/setup-host.sh (Ubuntu 22.04 ships 4.038; cocotb needs 5.x).
VERILATOR_VERSION=5.052

# gr-difi, the GNU Radio DIFI receiver for make ref-rx-check. Built unmodified from this
# commit by tests/hil/scripts/setup-host.sh into /opt/gr-difi-<commit>, against
# Ubuntu 22.04's GNU Radio 3.10.1.
GR_DIFI_COMMIT=330dd7f

# --- Software (not set up yet) ----------------------------------------

# AMD EDF / meta-xilinx release. Must correspond to VIVADO_VERSION.
EDF_RELEASE=2026.1
YOCTO_CODENAME=scarthgap
KAS_VERSION=5.4
